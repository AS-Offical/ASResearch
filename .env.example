# Copy to .env.local (never commit). On Vercel, set the same names in Project Settings -> Environment Variables.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Private side (Phase 3). Server-only: never prefix with NEXT_PUBLIC_. ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Long random strings (e.g. `openssl rand -base64 48`). Changing VAULT_PEPPER invalidates all vault codes.
VAULT_PEPPER=
SESSION_SECRET=

# Set to 1 to expose /[locale]/styleguide in a production build (verification only).
# ENABLE_STYLEGUIDE=1
# Set to 1 to show draft sample research in a production build (preview only).
# SHOW_DRAFTS=1
